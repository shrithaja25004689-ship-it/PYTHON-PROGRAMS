def Empcal():
    Name=input("Enter your name:")
    Age=int(input("Enter Age:"))
    Sal=float(input("Enter your Salary:"))
    HRA=(35*Sal)/100
    PF=(25*Sal)/100
    NetSalary= HRA+PF+Sal
    
    if (NetSalary>=50000) and (NetSalary<=100000):
        print("Senior Manager")
    elif (NetSalary>=20000) and (NetSalary<=49000):
        print(" Manager")
    else:
        print("Front Level Job")
    return Name, Age, NetSalary

Name, Age, NetSalary = Empcal()

print("Employee Name:",Name)
print("Employee Age:",Age)
print("Employee Salary:",NetSalary)


